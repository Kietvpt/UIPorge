{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BranchTemplate": "Server=ADMIN-PC\\SQLEXPRESS;Database=UIPorge_{branch};Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Branching": {
    "DefaultBranch": "BetaV1"
  },
  "Jwt": {
    "Key": "UIForge-Dev-Secret-Key-Change-In-Production-0123456789",
    "Issuer": "UIForge.API",
    "Audience": "UIForge.Client",
    "ExpiresHours": 12
  }
}
