# =================================================================
# 🌐 UIForge Deployment Configuration (.env)
# =================================================================

# 1. Domain Names & Automatic SSL (Caddy)
FRONTEND_DOMAIN=demo.uiforge.dev
API_DOMAIN=api.uiforge.dev
DOCS_DOMAIN=docs.uiforge.dev
ACME_EMAIL=admin@uiforge.dev

# 2. Database Provider Configuration
# Options: PostgreSQL (Default - Lightweight ~150MB RAM) | SqlServer | SQLite
DB_PROVIDER=PostgreSQL

# --- PostgreSQL Configuration (Default) ---
POSTGRES_DB=uiforge_db
POSTGRES_USER=uiforge_admin
POSTGRES_PASSWORD=UIForge_Secure_Pass_2026!
POSTGRES_PORT=5432

# --- Microsoft SQL Server Configuration (Optional via profile) ---
MSSQL_SA_PASSWORD=UIForge_SA_StrongPassword_2026!
MSSQL_PORT=1433

# 3. Backend .NET 8 Settings
ASPNETCORE_ENVIRONMENT=Production
JWT_KEY=UIForge_Super_Secret_Key_For_Jwt_Authentication_Must_Be_At_Least_32_Chars_Long_2026!
JWT_ISSUER=UIForgeAPI
JWT_AUDIENCE=UIForgeClient

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://demo.uiforge.dev,https://uiforge.dev,http://localhost:3000

# 4. Frontend API Endpoint
VITE_API_URL=https://api.uiforge.dev
