# =================================================================
# 🛡️ Caddyfile - Automatic SSL Reverse Proxy for UIForge
# =================================================================

{
    # Global ACME settings
    email {$ACME_EMAIL:admin@uiforge.dev}
}

# 1. Frontend Demo App (Client Template)
{$FRONTEND_DOMAIN:demo.uiforge.dev} {
    encode gzip zstd
    reverse_proxy frontend:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 2. Backend .NET 8 Web API
{$API_DOMAIN:api.uiforge.dev} {
    encode gzip zstd
    reverse_proxy backend:5048 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 3. Documentation & Landing Page Portal (Optional)
{$DOCS_DOMAIN:docs.uiforge.dev} {
    encode gzip zstd
    respond "UIForge Documentation & Landing Page - Coming Soon" 200
}
