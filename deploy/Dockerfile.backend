# =================================================================
# 🚀 UIForge Backend .NET 8 Dockerfile (Production Multi-Stage Build)
# =================================================================

# 1. Build & Publish Stage
FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
WORKDIR /src

# Copy project files for layer caching
COPY ["backend/UIForge.Core/UIForge.Core.csproj", "backend/UIForge.Core/"]
COPY ["backend/UIForge.API/UIForge.API.csproj", "backend/UIForge.API/"]

# Restore dependencies
RUN dotnet restore "backend/UIForge.API/UIForge.API.csproj"

# Copy full backend source code
COPY backend/ backend/

# Publish Release
WORKDIR "/src/backend/UIForge.API"
RUN dotnet publish "UIForge.API.csproj" -c Release -o /app/publish /p:UseAppHost=false

# 2. Final Runtime Stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS final
WORKDIR /app

# Install globalization cultures (ICU) and tzdata for global ERP runtime
RUN apk add --no-cache icu-libs tzdata
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    ASPNETCORE_URLS=http://+:5048 \
    ASPNETCORE_ENVIRONMENT=Production

# Copy published binaries from build stage
COPY --from=build /app/publish .

# Expose Web API port
EXPOSE 5048

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:5048/swagger/v1/swagger.json || exit 1

ENTRYPOINT ["dotnet", "UIForge.API.dll"]
