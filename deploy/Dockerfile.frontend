# =================================================================
# 🎨 UIForge Frontend Dockerfile (Vite + Nginx Production Image)
# =================================================================

# 1. Build Stage
FROM node:20-alpine AS build
WORKDIR /app

# Build arguments for dynamic backend URL
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}

# Install dependencies
COPY frontend/package*.json ./
RUN npm ci

# Copy source code and build client
COPY frontend/ ./
RUN npm run build

# 2. Production Runtime Stage (Nginx Alpine)
FROM nginx:alpine AS final
WORKDIR /usr/share/nginx/html

# Custom Nginx configuration supporting SPA clean routing
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Copy production bundle from build stage
COPY --from=build /app/dist .

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
