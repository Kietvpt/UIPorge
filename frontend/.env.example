# UIForge Frontend Environment Variables Template
# -------------------------------------------------------------
# 1. Local Development (Mặc định kết nối ASP.NET Core HTTPS):
VITE_API_URL=https://localhost:7057/api

# 2. Production / Staging Deployment (Ví dụ khi deploy lên cloud/server thật):
# VITE_API_URL=https://api.uiforge.yourdomain.com/api
# Hoặc nếu deploy Frontend + Backend chung domain qua Nginx reverse proxy:
# VITE_API_URL=/api

